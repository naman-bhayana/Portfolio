# The concierge. Copy to .env.local (gitignored) or set in Vercel; never commit values.
# Build time: "on" renders the concierge and adds its headers; anything else builds the site as before
NEXT_PUBLIC_CONCIERGE=
# Server key that mints session tokens: needs ElevenLabs Agents write (convai_write), nothing else
ELEVENLABS_API_KEY=
# The agent the concierge talks to
ELEVENLABS_AGENT_ID=
# HMAC secret that signs the post-call webhook
ELEVENLABS_WEBHOOK_SECRET=
# Sending-only key for the email after a conversation
CONCIERGE_RESEND_KEY=
# Sender of that email, a name and an address on a domain verified in Resend
CONCIERGE_FROM=
# Where that email goes
CONCIERGE_TO=
# 1 makes the session route answer 503 (kill switch)
CONCIERGE_PAUSED=
# Optional comma list of extra origins allowed to ask for a session
CONCIERGE_ORIGINS=
